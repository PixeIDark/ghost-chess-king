{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", ".env*"],
      "outputs": ["dist/**", ".next/**", "out/**"],
      "env": [
        "VITE_API_URL",
        "REDIS_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["src/**", "test/**", ".env*"],
      "outputs": []
    }
  }
}